# Copia este archivo a ".env" y completa los valores.
# NUNCA subas el archivo ".env" a GitHub (ya está en .gitignore).

PORT=5000

# Cadena de conexión de MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/tecnostore?retryWrites=true&w=majority

# URL(s) del frontend autorizadas por CORS, separadas por coma
CLIENT_URL=http://localhost:5173

# --- JSON Web Token (Tarea 5) ---
# Clave secreta para firmar los tokens. Usa una cadena larga y aleatoria. Ejemplo para generarla:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
# Tiempo de vida del token: exactamente 5 minutos
JWT_EXPIRES_IN=5m

# Datos del administrador que crea "npm run seed"
ADMIN_EMAIL=admin@tecnostore.com
ADMIN_NOMBRE=Administrador TecnoStore
ADMIN_PASSWORD=Admin12345
